# =====================================================================
# Rep+ - environment variables
# Copy to .env (local) and set the same keys in Vercel > Settings > Env.
# Generate secrets in PowerShell with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# =====================================================================

# ---- Database (Neon, Singapore region) ------------------------------
# Paste the strings exactly as Neon gives them (sslmode=require). The app
# upgrades require to verify-full for node-postgres on its own; Prisma
# migrate (DIRECT_URL) needs require.
# Pooled connection string (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/kasrat?sslmode=require"
# Direct (non-pooled) connection string. Used only by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/kasrat?sslmode=require"
# A SEPARATE empty database for Vitest (create a "kasrat_test" branch/db in Neon or local Postgres).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/kasrat_test?sslmode=require"

# ---- App ------------------------------------------------------------
APP_URL="http://localhost:3000"
# Root domain for athlete subdomains ({slug}.kasrat.app).
ROOT_DOMAIN="kasrat.app"

# ---- Auth secrets (all required) ------------------------------------
# HS256 key for gym staff + athlete access tokens. Min 32 chars.
JWT_SECRET=""
# Separate HS256 key for super admin tokens. Min 32 chars. Must differ from JWT_SECRET.
JWT_ADMIN_SECRET=""
# Pepper for hashing OTP codes (HMAC-SHA256).
OTP_PEPPER=""
# 32 random bytes, base64. AES-256-GCM key for sensitive fields (admin TOTP secret, medical notes).
# Never change it after data exists, or encrypted fields become unreadable.
ENCRYPTION_KEY=""
# HMAC key for rotating athlete QR codes (used from Phase 4).
QR_SECRET=""
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" to
# every /api/cron/* route. QR_SECRET also signs the pay links in reminders.
CRON_SECRET=""

# ---- Super admin seed (prisma/seed.ts) ------------------------------
ADMIN_SEED_ID="manmeet"
ADMIN_SEED_NAME="Manmeet Singh"
# Min 12 characters.
ADMIN_SEED_PASSWORD=""
# Base32 TOTP secret. Leave empty on first seed: the seed prints a new one
# to add to Google Authenticator, then paste it here so re-seeding keeps it.
ADMIN_SEED_TOTP_SECRET=""

# ---- Development helpers --------------------------------------------
# When "true" and WhatsApp is not configured, OTP codes are printed in the
# dev server terminal instead of being sent. Ignored in production.
DEV_LOG_OTP="true"

# ---- WhatsApp Cloud API (Meta) --------------------------------------
# Permanent system-user token with whatsapp_business_messaging permission.
WHATSAPP_TOKEN=""
# Phone number ID from WhatsApp Manager > API setup (not the phone number).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Meta app secret (App settings > Basic). Verifies X-Hub-Signature-256 on
# /api/webhooks/whatsapp. Required in production.
WHATSAPP_APP_SECRET=""
# Any random string; paste the same as "Verify token" in the Meta webhook
# config (callback URL: https://<your-domain>/api/webhooks/whatsapp).
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Approved AUTHENTICATION template name, created in en, hi and pa.
WHATSAPP_OTP_TEMPLATE="kasrat_otp"

# ---- How gyms pay Rep+ (no payment gateway yet) ---------------------
# Owners pay by UPI or bank transfer from Rep+ billing and submit the UTR;
# you approve it in /admin/billing. Shown on the owner billing page.
KASRAT_UPI_ID="kasrat@okhdfcbank"
KASRAT_UPI_NAME="Rep+"
# Use \n for new lines.
KASRAT_BANK_DETAILS="A/c name: Rep+\nA/c no: 000000000000\nIFSC: HDFC0000000\nBank: HDFC Bank, Mohali"
# Your WhatsApp number (with country code, digits only) for "Book a demo" and support links.
KASRAT_SUPPORT_WHATSAPP="919876543210"

# ---- Razorpay (optional, not used yet) -------------------------------
# Kept for later. Leave empty: the webhook route then rejects every call.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Brevo transactional email (never Resend) -----------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@kasrat.app"
BREVO_SENDER_NAME="Rep+"

# ---- Groq (motivation lines + owner insights) -----------------------
# Optional. Without a key the curated lines in /locales are used.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ---- Cloudinary (logos public, progress photos authenticated) -------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Web push for the athlete PWA (Phase 6) -------------------------
# Free, no sign-up. Generate once with:  npx web-push generate-vapid-keys
# Put the public key in both VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Never change them after launch, or every member has to turn push on again.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:support@kasrat.app"

# ---- Health app sync (postponed) -------------------------------------
# Not built yet; shown to gyms as "Coming soon". Leave these empty.
TERRA_DEV_ID=""
TERRA_API_KEY=""
TERRA_WEBHOOK_SECRET=""

# ---- Showcase / demo login (optional) --------------------------------
# For a demo deployment without WhatsApp: these numbers log in with the fixed
# code below and no WhatsApp message is sent. Comma separated, +91 format.
# LEAVE BOTH EMPTY when real gyms use the site.
DEMO_LOGIN_CODE=""
DEMO_LOGIN_PHONES=""
